NODE_ENV=production
PORT=5000

# Database
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Required application JWT secret
JWT_SECRET=

# Central VexaAccount SSO configuration. Provision the client in VexaAccount Super Admin first.
# For the backend callback flow, redirectUri should be:
# https://api-vexastore.onrender.com/api/auth/vexaaccount/callback
VEXA_ACCOUNT_SSO_CONFIG={"url":"https://api-vexaaccount.onrender.com","clientId":"<CLIENT_ID>","clientSecret":"<CLIENT_SECRET>","redirectUri":"https://api-vexastore.onrender.com/api/auth/vexaaccount/callback","timeoutMs":10000,"frontendUrl":"https://vexastore.onrender.com"}
VEXA_ACCOUNT_SSO_STATE_SECRET=

FRONTEND_USER_URL=https://vexastore.onrender.com
FRONTEND_ADMIN_URL=https://vexastore-admin.onrender.com
