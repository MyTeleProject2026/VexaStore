<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0e1a" />
      <stop offset="100%" stop-color="#050812" />
    </linearGradient>
    <linearGradient id="vGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#06b6d4" />
      <stop offset="100%" stop-color="#10b981" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="100" height="100" rx="20" ry="20" fill="url(#bgGrad)" stroke="rgba(255,255,255,0.08)" stroke-width="1.5" />

  <!-- Outer glow ring -->
  <circle cx="50" cy="50" r="40" fill="none" stroke="rgba(6,182,212,0.15)" stroke-width="1" />

  <!-- V shape with download arrow -->
  <g transform="translate(50, 50) scale(0.8)">
    <!-- Left leg of V (with arrow tip) -->
    <path d="M-25,-25 L-5,15 L5,15 L25,-25" 
          fill="none" 
          stroke="url(#vGrad)" 
          stroke-width="6" 
          stroke-linecap="round" 
          stroke-linejoin="round" />

    <!-- Right leg of V -->
    <path d="M25,-25 L5,15" 
          fill="none" 
          stroke="url(#vGrad)" 
          stroke-width="6" 
          stroke-linecap="round" />

    <!-- Arrow tip at bottom -->
    <path d="M-12,22 L0,30 L12,22" 
          fill="none" 
          stroke="url(#vGrad)" 
          stroke-width="5" 
          stroke-linecap="round" 
          stroke-linejoin="round" />

    <!-- Small dot / node (blockchain reference) -->
    <circle cx="0" cy="-28" r="4" fill="#06b6d4" />
    <circle cx="0" cy="-28" r="8" fill="none" stroke="rgba(6,182,212,0.3)" stroke-width="1.5" />
  </g>

  <!-- Subtle shine -->
  <circle cx="30" cy="30" r="20" fill="rgba(255,255,255,0.03)" />
</svg>
